# Copia este archivo como .env y cambia las contraseñas.
#   bash:       cp .env.example .env
#   PowerShell: Copy-Item .env.example .env
# El archivo .env no se sube a git.

# ---------- Contenedor de MariaDB (db) ----------
# Contraseña del usuario root de MariaDB.
MARIADB_ROOT_PASSWORD=cambia_root_1234
# Base de datos que se crea al arrancar por primera vez (aquí se ejecuta db/init.sql).
MARIADB_DATABASE=slime_tracker
# Usuario de la aplicación, con permisos solo sobre MARIADB_DATABASE.
MARIADB_USER=slime_app
# Contraseña de ese usuario.
MARIADB_PASSWORD=cambia_app_1234

# ---------- Conexión de la aplicación (app) ----------
# Nombre del servicio de base de datos dentro de la red de Docker.
DB_HOST=db
# Puerto de MariaDB dentro de la red de Docker.
DB_PORT=3306
# Tienen que coincidir con MARIADB_DATABASE, MARIADB_USER y MARIADB_PASSWORD.
DB_NAME=slime_tracker
DB_USER=slime_app
DB_PASSWORD=cambia_app_1234

# ---------- Puertos publicados en tu equipo ----------
# Aplicación web: http://localhost:8080
APP_PORT=8080
# Adminer: http://localhost:8081
ADMINER_PORT=8081
